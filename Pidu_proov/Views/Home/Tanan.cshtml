@model Pidu_proov.Models.Kylaline
@{
    ViewBag.Title = "Tänan osalemise eest!";
}
<h2>Aitäh, @Model.Nimi!</h2>
<p>Sinu vastus on edukalt salvestatud.</p>

@if (Model.OnKutse)
{
    <p class="text-success">
        <strong> Rõõm kuulda! Ootame sind üritusele @ViewBag.Pyhanimetus!</strong>
    </p>
    <div class="image-container">
        <img src="@Url.Content("~/Images/" + ViewBag.Pilt)" style="width:300px;" />
    </div>
}
else
{
    <p class="text-danger">
        <strong> Kahju, et ei saa tulla üritusele @ViewBag.Pyhanimetus!</strong>
    </p>
    <div class="image-container">
        <img src="@Url.Content("~/Images/" + ViewBag.Pilt)" style="width:300px;" />
    </div>
}


@*<p>Ootame/ei oota sind üritusele @ViewBag.Pyhanimetus!</p>
    <div class="image-container">
        <img src="@Url.Content("~/Images/" + ViewBag.Pilt)" style="width:300px;" />
    </div>*@
@Html.ActionLink("Tagasi avalehele", "Index", "Home", null, new { @class = "btn btn-default" })

@if (ViewBag.EmailViga != null)
{
    <div class="alert alert-danger" style="margin-top:15px;">
        <strong>E-kirja saatmine ebaõnnestus:</strong> @ViewBag.EmailViga
    </div>
}
else
{
    <p class="text-success" style="margin-top:15px;">✔ E-kiri saadeti edukalt aadressile @Model.Email</p>
}
