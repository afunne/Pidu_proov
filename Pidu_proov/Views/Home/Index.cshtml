    <div class="row">
        @* Viitame HomeControllerile, sest Ankeet meetod asub seal! *@
        <p class="lead">Tee oma valik:</p>
        @Html.ActionLink("Vastan küsimustele", "Ankeet", "Home", null, new { @class = "btn btn-primary btn-md" })
    </div>
</main>