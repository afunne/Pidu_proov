@{
    ViewBag.Title = "Home Page";
}

<main>
    <section class="row" aria-labelledby="aspnetTitle">
        <h1 id="title">Meie pühad</h1>
        
        
    </section>

    <div class="row">
        @* Viitame PyhasControllerile ja Index meetodile *@
        <p class="lead">Uuri meie pakkumised:</p>
        @Html.ActionLink("Meie pühad", "Index", "Pyhas", null, new { @class = "btn btn-primary btn-md" })
