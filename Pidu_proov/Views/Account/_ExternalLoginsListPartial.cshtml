@model Pidu_proov.Models.ExternalLoginListViewModel
@using Microsoft.Owin.Security

<h4>Kasuta teist teenust sisselogimiseks.</h4>
<hr />
@{
    var loginProviders = Context.GetOwinContext().Authentication.GetExternalAuthenticationTypes();
    if (loginProviders.Count() == 0) {
        <div>
            <p>
                Ühtegi välist autentimisteeenust pole konfigureeritud. Vaata <a href="https://go.microsoft.com/fwlink/?LinkId=403804">seda artiklit</a>
                väliste teenuste kaudu sisselogimise seadistamiseks.
            </p>
        </div>
    }
    else {
        using (Html.BeginForm("ExternalLogin", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post, new { role = "form" })) {
            @Html.AntiForgeryToken()
            <div id="socialLoginList">
                <p>
                    @foreach (AuthenticationDescription p in loginProviders) {
                        <button type="submit" class="btn btn-outline-dark" id="@p.AuthenticationType" name="provider" value="@p.AuthenticationType" title="Logi sisse kasutades @p.Caption kontot">@p.AuthenticationType</button>
                    }
                </p>
            </div>
        }
    }
}
