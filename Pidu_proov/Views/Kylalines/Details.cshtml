@model Pidu_proov.Models.Kylaline

@{
    ViewBag.Title = "Külaline detailid";
}

<h2>Külaline detailid</h2>

<div>
    <h4>Külaline</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.Nimi)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Nimi)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Email)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Email)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.OnKutse)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.OnKutse)
        </dd>

        <dt>
            Üritus
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Pyha.Nimetus)
        </dd>

        <dt>
            Hind
        </dt>

        <dd>
            @if (Model.OnKutse) {
                <strong>@Model.Pyha.HindMax €</strong>
                <span class="text-muted"> – maksimaalne hind (tuleb koos inimestega)</span>
            } else {
                <strong>@Model.Pyha.HindMin €</strong>
                <span class="text-muted"> – minimaalne hind (tuleb üksinda)</span>
            }
        </dd>

    </dl>
</div>
<p>
    @Html.ActionLink("Muuda", "Edit", new { id = Model.Id }) |
    @Html.ActionLink("Tagasi nimekirja", "Index")
</p>
