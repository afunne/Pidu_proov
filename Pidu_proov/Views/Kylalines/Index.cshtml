@model IEnumerable<Pidu_proov.Models.Kylaline>

@{
    ViewBag.Title = "Külalised";
}

<h2>Külaliste haldus @(ViewBag.Filter!=null? "-"+ViewBag.Filter: "")</h2>

<p>
    @Html.ActionLink("Kõik külalised", "Index", null, new { @class = "btn btn-default" })
    @Html.ActionLink("Tulevad", "Tulevad", null, new { @class = "btn btn-success" })
    @Html.ActionLink("Ei tule", "Mittetulevad", null, new { @class = "btn btn-danger" })


</p>
<table class="table">
    <tr>
        <th>
            Külalise nimi
        </th>
        <th>
            E-post
        </th>
        <th>
            Üritus
        </th>
        <th>
            Tuleb koos inimestega
        </th>
        <th>
            Hind
        </th>
        <th>
            Tegevused
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Nimi)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Email)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Pyha.Nimetus)
        </td>
        <td>
            @if (item.OnKutse) {
                <span class="badge bg-success">Jah (koos inimestega)</span>
            } else {
                <span class="badge bg-secondary">Ei (üksinda)</span>
            }
        </td>
        <td>
            @if (item.OnKutse) {
                <strong>@item.Pyha.HindMax €</strong>
                <small class="text-muted d-block">(maksimaalne hind – tuleb koos inimestega)</small>
            } else {
                <strong>@item.Pyha.HindMin €</strong>
                <small class="text-muted d-block">(minimaalne hind – tuleb üksinda)</small>
            }
        </td>
        <td>
            @Html.ActionLink("Muuda", "Edit", new { id=item.Id }) |
            @Html.ActionLink("Detailid", "Details", new { id=item.Id }) |
            @Html.ActionLink("Kustuta", "Delete", new { id=item.Id })
        </td>
    </tr>
}

</table>
